MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1676476420}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 66503d9c075c3584aadd11c42ef5a213, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  mainCameraTracker: {fileID: 1843240916}
  responnerPlayer: {fileID: 1667197827}
  responnerEagle: {fileID: 1845123010}
  responnerOpossum: {fileID: 247953318}
  monsterInventory: {fileID: 1676476423}
  guiManager: {fileID: 1363092649}
  guiPlayerInfo: {fileID: 1943611740}
  majorVersion: 0
  releaseVersion: 0
  patchVersion: 2
  enableLegacyGUI: 0
  toggleLegacyGUIKey: 283
  showVersionGUI: 0
  showTroubleshootingList: 0
  troubleshootingList:
  - type: "\uC624\uB958"
    foundVersion: 0.00.00
    status: "\uC644\uB8CC"
    appliedVersion: 0.00.01
    description: "\uD1A0\uD0C8\uAC74\uC73C\uB85C \uC885\uB958\uB97C \uBCC0\uACBD\uD558\uC5EC\uB3C4
      \uC791\uB3D9\uC740 \uD558\uB098 \uC624\uBE0C\uC81D\uD2B8\uAC00 \uD65C\uC131\uD654
      \uB418\uC9C0\uC54A\uC74C."
    cause: "\uBE44\uD65C\uC131\uD654 \uB41C \uAC1D\uCCB4\uC5D0\uC11C api\uB85C \uC811\uADFC\uD558\uAE30
      \uB54C\uBB38\uC5D0 \uC791\uB3D9 \uAC00\uB2A5"
    solution: "TotalGun\uC5D0\uC11C SetGunType \uC2DC \uD558\uC704 \uBB34\uAE30 \uD65C\uC131\uD654/\uBE44\uD65C\uC131\uD654
      \uCC98\uB9AC \uB85C\uC9C1 \uAD6C\uD604"
  - type: "\uC624\uB958"
    foundVersion: 0.00.00
    status: "\uC644\uB8CC"
    appliedVersion: 0.00.02
    description: "\uC0F7\uAC74\uC5D0\uC11C \uBC1C\uC0AC\uAC01\uB3C4\uB97C \uC218\uC815\uD574\uB3C4
      \uC218\uC815\uB418\uC9C0\uC54A\uC74C."
    cause: "\uBC1C\uC0AC \uC704\uCE58 \uBC0F \uBC29\uD5A5 \uC124\uC815 \uC2DC \uBD80\uCC44\uAF34
      \uBD84\uC0B0\uAC01(spreadAngle) \uBBF8\uBC18\uC601 \uBC0F \uCF54\uB4DC \uC911\uBCF5
      \uC0DD\uC131 \uACB0\uD568"
    solution: "\uD0C0\uAC9F \uC0AC\uC774\uAC01 \uBE44\uAD50 \uD6C4 \uC815\uBA74/\uD0C0\uAC9F
      \uAE30\uC900 \uAC01\uB3C4 \uC0B0\uCD9C \uBC0F Random.Range \uAE30\uBC18 \uB2E8\uC77C
      \uD0C4\uD658 \uBC1C\uC0AC \uD30C\uC774\uD504\uB77C\uC778 \uC815\uB9AC"
  - type: "\uBC84\uADF8"
    foundVersion: 0.00.01
    status: "\uD14C\uC2A4\uD2B8\uC694\uCCAD"
    appliedVersion: 0.00.02
    description: "\uCD1D\uC54C\uC774 \uC18D\uB3C4\uAC00 \uBE60\uB97C \uB54C \uC6D0\uD558\uC9C0
      \uC54A\uB294 \uBC29\uD5A5\uC73C\uB85C \uBC18\uC0AC\uB428"
    cause: "\uCD1D\uC54C\uC758 \uC18D\uB3C4\uAC00 \uBE68\uB77C \uD130\uB110\uB9C1
      \uD604\uC0C1\uC774 \uBC1C\uC0DD\uD558\uC5EC \uCDA9\uB3CC\uCCB4\uD06C\uC5D0
      \uC624\uB958\uAC00 \uC77C\uC5B4\uB0A8"
    solution: "\uD130\uB110\uB9C1 \uD604\uC0C1\uC744 \uD574\uACB0\uD558\uAE30 \uC704\uD574
      FixedUpdate\uB97C \uC0AC\uC6A9\uD558\uACE0, \uCDA9\uB3CC \uC2DC \uCDA9\uB3CC
      \uC704\uCE58(\uC811\uC810/\uBC95\uC120)\uB97C \uD655\uC778\uD558\uC5EC \uC608\uC678\uCC98\uB9AC
      \uBC0F \uC704\uCE58 \uBCF4\uC815\uD568"
